# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# Conexão PostgreSQL (o docker-compose.yml usa estes valores por padrão)
DATABASE_URL="postgresql://soberano:troque-esta-senha@localhost:5432/soberano?schema=public"
# Conexão direta usada pelas migrações. Localmente = DATABASE_URL. Na nuvem, veja o README (seção Publicação).
DIRECT_URL="postgresql://soberano:troque-esta-senha@localhost:5432/soberano?schema=public"
POSTGRES_PASSWORD="troque-esta-senha"

# Usuários iniciais criados pelo seed (somente na primeira execução).
# Se as senhas ficarem em branco, o seed gera senhas aleatórias fortes e as exibe UMA vez no terminal.
SEED_ADMIN_EMAIL="admin@soberano.local"
SEED_ADMIN_SENHA=""
SEED_VISUALIZADOR1_EMAIL="visualizador1@soberano.local"
SEED_VISUALIZADOR1_SENHA=""
SEED_VISUALIZADOR2_EMAIL="visualizador2@soberano.local"
SEED_VISUALIZADOR2_SENHA=""

# Duração da sessão em horas
SESSAO_DURACAO_HORAS=8

# Armazenamento dos documentos: "local" (pasta no disco — PC ou VPS) ou "supabase" (obrigatório na Vercel).
STORAGE_DRIVER="local"

# Modo local: pasta PRIVADA dos documentos (fora de /public). Padrão: ./storage/documentos
STORAGE_DIR=""

# Modo supabase: bucket PRIVADO. A chave secreta fica só no servidor — nunca use prefixo NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="documentos"
